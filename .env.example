# Database
DATABASE_URL="file:./dev.db"

# JWT secret untuk session token (WAJIB diganti dengan string acak panjang)
JWT_SECRET="ganti-dengan-string-acak-yang-panjang-dan-aman"

# =====================================================================
# Public site URL — dipakai untuk metadataBase (OG image, canonical, dst).
# Tanpa ini, link preview WhatsApp/Facebook tidak menampilkan logo karena
# URL gambar OG jadi relatif (localhost). WAJIB diisi di production.
# =====================================================================
NEXT_PUBLIC_SITE_URL="https://www.kosbaiti.com"

# =====================================================================
# Email (untuk reset password & reminder pembayaran)
# =====================================================================
# "dev"     (default) -> tidak kirim email, link reset tampil di UI
# "resend"            -> kirim via Resend API
EMAIL_MODE="dev"
RESEND_API_KEY=""
EMAIL_FROM=""

# =====================================================================
# WhatsApp gateway (untuk reminder pembayaran via WA)
# =====================================================================
# Mode pengiriman OTP/WA blast: "dev" (no-op), "fonnte", atau "generic".
OTP_MODE="dev"
WA_GATEWAY_TOKEN=""
WA_GATEWAY_URL=""

# Anti-spam: jam berapa cron reminder TIDAK BOLEH kirim WA (WIB).
# Default 22-06 WIB — pesan dini hari sangat memicu spam-flag Meta.
# Set keduanya = 0 untuk nonaktif (TIDAK direkomendasikan).
# Email & notif in-app TIDAK kena guard ini, tetap dikirim.
WA_QUIET_HOURS_START="22"
WA_QUIET_HOURS_END="6"

# Kill-switch global: set "false" untuk matikan SEMUA pengiriman WA
# (tanpa ubah kode). Berguna saat akun di-restrict Meta atau gateway
# down — aksi user yang trigger WA tetap sukses, log "skip WA_ENABLED=false".
WA_ENABLED="true"

# =====================================================================
# WhatsApp Business Cloud API resmi Meta (alternative ke Fonnte).
# Gratis 1000 conversation/bulan, native support image header +
# preview_url. Aktifkan saat siap migrasi dari Fonnte.
#
# Setup lengkap: docs/wa-cloud/setup.md
# Template yang perlu di-approve di Meta: docs/wa-cloud/templates.md
# Migrasi flow: docs/wa-cloud/migration.md
#
# Ubah OTP_MODE="cloud" untuk aktifkan. WA_GATEWAY_TOKEN tidak dipakai
# untuk cloud mode.
# =====================================================================
META_WA_PHONE_ID=""
META_WA_TOKEN=""
META_WA_API_VERSION="v18.0"

# Mode preview gambar inline (Fonnte only — paid tier):
# "false" (default) -> Mode text-only. Pesan terkirim sebagai teks
#                       biasa dengan URL clickable di atas. Sederhana
#                       dan paling reliable.
# "true"            -> Coba kirim og-image.jpg sebagai attachment file
#                       dengan teks sebagai caption. HANYA bekerja di
#                       Fonnte paid plan — free trial silently buang
#                       media uploads (terbukti dari log: API accept
#                       dengan status:true, quota dipotong, tapi
#                       recipient cuma terima text). Aktifkan setelah
#                       Anda upgrade Fonnte plan & verifikasi recipient
#                       benar terima image.
WA_INLINE_PREVIEW="false"

# =====================================================================
# Payment gateway (untuk auto-verifikasi pembayaran via QRIS/VA/e-wallet)
# =====================================================================
# "mock"     (default) -> generate URL dummy, langsung lunas. Untuk demo.
# "midtrans"           -> integrasi Midtrans Snap (production-ready).
PAYMENT_GATEWAY="mock"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_PROD="0"

# =====================================================================
# Cron secret untuk endpoint /api/cron/reminders
# =====================================================================
# Set ke string acak panjang. Jadwalkan POST ke /api/cron/reminders dengan
# header "Authorization: Bearer $CRON_SECRET" atau ?token=$CRON_SECRET.
CRON_SECRET=""

# =====================================================================
# Web Push (notifikasi PWA ke HP penghuni)
# =====================================================================
# Generate sepasang kunci sekali jalan:
#   npx web-push generate-vapid-keys
# Lalu isi keduanya di Railway. Public key boleh di client (prefix
# NEXT_PUBLIC_). Tanpa kunci ini, push otomatis no-op (in-app + email
# tetap jalan). VAPID_SUBJECT = mailto kontak admin (opsional).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@kosbaiti.com"
