# Database
DATABASE_URL="file:./dev.db"

# JWT secret untuk session token
JWT_SECRET="ganti-dengan-string-acak-yang-panjang-dan-aman"

# Mode OTP: "dev" akan mencetak OTP di console (tidak kirim SMS/WA).
# Ganti ke "production" dan isi konfigurasi gateway saat live.
OTP_MODE="dev"

# (Opsional) Gateway WA/SMS — isi saat siap integrasi
WA_GATEWAY_URL=""
WA_GATEWAY_TOKEN=""
