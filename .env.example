# Database
DATABASE_URL="file:./dev.db"

# JWT secret untuk session token (WAJIB diganti dengan string acak panjang)
JWT_SECRET="ganti-dengan-string-acak-yang-panjang-dan-aman"

# =====================================================================
# Public site URL — dipakai untuk metadataBase (OG image, canonical, dst).
# Tanpa ini, link preview WhatsApp/Facebook tidak menampilkan logo karena
# URL gambar OG jadi relatif (localhost). WAJIB diisi di production.
# =====================================================================
NEXT_PUBLIC_SITE_URL="https://www.kosbaiti.com"

# =====================================================================
# Email (untuk reset password & reminder pembayaran)
# =====================================================================
# "dev"     (default) -> tidak kirim email, link reset tampil di UI
# "resend"            -> kirim via Resend API
EMAIL_MODE="dev"
RESEND_API_KEY=""
EMAIL_FROM=""

# =====================================================================
# WhatsApp gateway (untuk reminder pembayaran via WA)
# =====================================================================
# Mode pengiriman OTP/WA blast: "dev" (no-op), "fonnte", atau "generic".
OTP_MODE="dev"
WA_GATEWAY_TOKEN=""
WA_GATEWAY_URL=""

# Anti-spam: jam berapa cron reminder TIDAK BOLEH kirim WA (WIB).
# Default 22-06 WIB — pesan dini hari sangat memicu spam-flag Meta.
# Set keduanya = 0 untuk nonaktif (TIDAK direkomendasikan).
# Email & notif in-app TIDAK kena guard ini, tetap dikirim.
WA_QUIET_HOURS_START="22"
WA_QUIET_HOURS_END="6"

# Kill-switch global: set "false" untuk matikan SEMUA pengiriman WA
# (tanpa ubah kode). Berguna saat akun di-restrict Meta atau gateway
# down — aksi user yang trigger WA tetap sukses, log "skip WA_ENABLED=false".
WA_ENABLED="true"

# =====================================================================
# Payment gateway (untuk auto-verifikasi pembayaran via QRIS/VA/e-wallet)
# =====================================================================
# "mock"     (default) -> generate URL dummy, langsung lunas. Untuk demo.
# "midtrans"           -> integrasi Midtrans Snap (production-ready).
PAYMENT_GATEWAY="mock"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_PROD="0"

# =====================================================================
# Cron secret untuk endpoint /api/cron/reminders
# =====================================================================
# Set ke string acak panjang. Jadwalkan POST ke /api/cron/reminders dengan
# header "Authorization: Bearer $CRON_SECRET" atau ?token=$CRON_SECRET.
CRON_SECRET=""
