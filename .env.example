# Database
DATABASE_URL="file:./dev.db"

# JWT secret untuk session token (WAJIB diganti dengan string acak panjang)
JWT_SECRET="ganti-dengan-string-acak-yang-panjang-dan-aman"

# =====================================================================
# Email (untuk reset password)
# =====================================================================
# Mode pengiriman email. Pilih salah satu:
#   "dev"     (default) : tidak mengirim email; link reset tampil di
#                         halaman "Lupa password" sebagai banner kuning.
#                         Cocok untuk pengembangan & demo.
#   "resend"            : kirim via Resend (https://resend.com).
#                         Daftar gratis -> buat API Key -> isi di bawah.
EMAIL_MODE="dev"

# Hanya jika EMAIL_MODE="resend":
RESEND_API_KEY=""
# Alamat pengirim, contoh: "Kelola Kos <noreply@kelolakos.id>".
# Untuk pakai domain custom, verifikasi domain dulu di dashboard Resend.
EMAIL_FROM=""
