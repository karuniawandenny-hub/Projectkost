# Database
DATABASE_URL="file:./dev.db"

# JWT secret untuk session token (WAJIB diganti dengan string acak panjang)
JWT_SECRET="ganti-dengan-string-acak-yang-panjang-dan-aman"

# =====================================================================
# Konfigurasi pengiriman OTP
# =====================================================================
# Mode pengiriman OTP. Pilih salah satu:
#   "dev"      -> OTP tidak dikirim ke HP; ditampilkan di halaman verifikasi
#                 (banner kuning) dan tercetak di terminal. Untuk testing.
#   "fonnte"   -> Kirim via Fonnte (gateway WhatsApp Indonesia, https://fonnte.com).
#                 Daftar -> buat Device -> copy "Device Token" -> isi WA_GATEWAY_TOKEN.
#   "generic"  -> POST JSON ke WA_GATEWAY_URL dengan header Authorization: Bearer <token>.
#                 Body request: { "phone": "+628...", "message": "..." }.
OTP_MODE="dev"

# Untuk OTP_MODE="fonnte": isi Device Token dari Fonnte.
# Untuk OTP_MODE="generic": isi token Bearer dari gateway Anda.
WA_GATEWAY_TOKEN=""

# Hanya untuk OTP_MODE="generic": endpoint gateway.
WA_GATEWAY_URL=""
