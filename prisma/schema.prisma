// Prisma schema untuk aplikasi pengelolaan kos
// Catatan: SQLite tidak mendukung native enum di Prisma; status disimpan sebagai
// string. Konstanta diturunkan di src/lib/enums.ts untuk type-safety.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  username        String?   @unique
  passwordHash    String
  name            String
  phone           String?
  role            String    // "OWNER" | "TENANT" | "ADMIN"
  status          String    @default("ACTIVE") // "ACTIVE" | "PENDING" | "SUSPENDED"
  ktpPhotoUrl     String?
  selfiePhotoUrl  String?
  onboardedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ownedKos        Kos[]          @relation("OwnerKos")
  tenancies       Tenancy[]
  notifications   Notification[]
  passwordResets  PasswordResetToken[]
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Kos {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  address     String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User     @relation("OwnerKos", fields: [ownerId], references: [id], onDelete: Cascade)
  rooms       Room[]

  @@index([ownerId])
}

model Room {
  id            String   @id @default(cuid())
  kosId         String
  name          String
  monthlyPrice  Int
  status        String   @default("AVAILABLE") // "AVAILABLE" | "OCCUPIED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  kos           Kos       @relation(fields: [kosId], references: [id], onDelete: Cascade)
  tenancies     Tenancy[]
  movesFrom     RoomMoveRequest[] @relation("FromMove")
  movesTo       RoomMoveRequest[] @relation("ToMove")

  @@index([kosId])
}

model Tenancy {
  id         String    @id @default(cuid())
  tenantId   String
  roomId     String
  startDate  DateTime  @default(now())
  endDate    DateTime?
  status     String    @default("ACTIVE") // "ACTIVE" | "ENDED"
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant     User      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  payments   Payment[]
  complaints Complaint[]
  moveRequests RoomMoveRequest[]

  @@index([tenantId])
  @@index([roomId])
}

model Payment {
  id          String   @id @default(cuid())
  tenancyId   String
  periodMonth Int
  periodYear  Int
  amount      Int
  proofUrl    String
  status      String   @default("PENDING") // "PENDING" | "VERIFIED" | "REJECTED"
  note        String?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenancy     Tenancy  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  @@index([tenancyId])
  @@index([status])
}

model Complaint {
  id                  String   @id @default(cuid())
  tenancyId           String
  title               String
  description         String
  photoUrls           String   // JSON array of urls (foto dari penghuni)
  status              String   @default("OPEN") // "OPEN" | "IN_PROGRESS" | "RESOLVED"
  ownerReply          String?
  resolutionPhotoUrls String?  // JSON array of urls (foto bukti dari pemilik)
  resolvedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenancy             Tenancy  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  @@index([tenancyId])
  @@index([status])
}

model RoomMoveRequest {
  id         String    @id @default(cuid())
  tenancyId  String
  fromRoomId String
  toRoomId   String
  reason     String?
  status     String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  ownerNote  String?
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?

  tenancy    Tenancy   @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  fromRoom   Room      @relation("FromMove", fields: [fromRoomId], references: [id], onDelete: Cascade)
  toRoom     Room      @relation("ToMove", fields: [toRoomId], references: [id], onDelete: Cascade)

  @@index([tenancyId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
