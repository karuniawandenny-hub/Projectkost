// Prisma schema untuk aplikasi pengelolaan kos
// Catatan: SQLite tidak mendukung native enum di Prisma; status disimpan sebagai
// string. Konstanta diturunkan di src/lib/enums.ts untuk type-safety.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  username        String?   @unique
  passwordHash    String
  name            String
  phone           String?
  role            String    // "OWNER" | "TENANT" | "ADMIN"
  status          String    @default("ACTIVE") // "ACTIVE" | "PENDING" | "SUSPENDED"
  ktpPhotoUrl     String?
  selfiePhotoUrl  String?
  onboardedAt     DateTime?
  // Preferensi notifikasi (JSON). Null = pakai default (semua on,
  // jam tenang aktif 22-06). Shape didefinisikan di src/lib/notif-prefs.ts.
  notifPrefs      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ownedKos          Kos[]          @relation("OwnerKos")
  tenancies         Tenancy[]
  notifications     Notification[]
  passwordResets    PasswordResetToken[]
  pushSubscriptions PushSubscription[]
  announcements     Announcement[] @relation("AnnouncementAuthor")
  expensesCreated   Expense[]      @relation("ExpenseCreator")
  auditEntries      AuditLog[]
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Kos {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  address     String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User     @relation("OwnerKos", fields: [ownerId], references: [id], onDelete: Cascade)
  rooms       Room[]
  maintenances Maintenance[]
  announcements Announcement[]
  expenses     Expense[]

  @@index([ownerId])
}

model Room {
  id            String   @id @default(cuid())
  kosId         String
  name          String
  monthlyPrice  Int
  status        String   @default("AVAILABLE") // "AVAILABLE" | "OCCUPIED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  kos           Kos       @relation(fields: [kosId], references: [id], onDelete: Cascade)
  tenancies     Tenancy[]
  movesFrom     RoomMoveRequest[] @relation("FromMove")
  movesTo       RoomMoveRequest[] @relation("ToMove")
  maintenances  Maintenance[]

  @@index([kosId])
}

model Tenancy {
  id         String    @id @default(cuid())
  tenantId   String
  roomId     String
  startDate  DateTime  @default(now())
  endDate    DateTime?
  status     String    @default("ACTIVE") // "ACTIVE" | "ENDED"
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant     User      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  payments   Payment[]
  complaints Complaint[]
  moveRequests RoomMoveRequest[]

  @@index([tenantId])
  @@index([roomId])
}

model Payment {
  id           String   @id @default(cuid())
  tenancyId    String
  periodMonth  Int
  periodYear   Int
  amount       Int
  proofUrl     String?  // null saat status = DUE (tagihan otomatis, belum diupload)
  status       String   @default("DUE") // "DUE" | "PENDING" | "VERIFIED" | "REJECTED"
  dueDate      DateTime? // tanggal jatuh tempo (untuk reminder query cepat)
  note         String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenancy      Tenancy        @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  reminders    ReminderLog[]
  gatewayTxs   GatewayTransaction[]

  @@unique([tenancyId, periodMonth, periodYear])
  @@index([tenancyId])
  @@index([status])
  @@index([dueDate])
}

model ReminderLog {
  id        String   @id @default(cuid())
  paymentId String
  type      String   // "H7" | "H3" | "H1" | "OVERDUE"
  channel   String   // "EMAIL" | "WA" | "IN_APP"
  sentAt    DateTime @default(now())
  error     String?

  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, type, channel])
  @@index([paymentId])
}

model GatewayTransaction {
  id            String   @id @default(cuid())
  paymentId     String
  provider      String   // "MIDTRANS" | "XENDIT" | "MOCK"
  externalId    String   // order_id / transaction id di gateway
  amount        Int
  status        String   // "PENDING" | "PAID" | "EXPIRED" | "FAILED"
  paymentMethod String?  // "qris" | "va_bca" | "ovo" | dst
  raw           String?  // raw payload terakhir dari gateway (JSON)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  paidAt        DateTime?

  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([paymentId])
  @@index([status])
}

model Complaint {
  id                  String   @id @default(cuid())
  tenancyId           String
  title               String
  description         String
  photoUrls           String   // JSON array of urls (foto dari penghuni)
  status              String   @default("OPEN") // "OPEN" | "IN_PROGRESS" | "RESOLVED"
  ownerReply          String?
  resolutionPhotoUrls String?  // JSON array of urls (foto bukti dari pemilik)
  resolvedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenancy             Tenancy  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  maintenance         Maintenance?

  @@index([tenancyId])
  @@index([status])
}

/// Maintenance: catatan perawatan & perbaikan kos/kamar.
///
/// Dua jenis:
///   - PREVENTIVE: dijadwalkan pemilik. Bisa berulang (recurrenceMonths
///     diisi) → saat selesai, sistem auto-bikin record berikutnya.
///   - CORRECTIVE: auto-tercipta saat komplain penghuni RESOLVED. 1:1
///     dengan Complaint via complaintId. Statusnya langsung COMPLETED
///     karena komplain yang RESOLVED memang sudah diperbaiki.
///
/// Cakupan:
///   - kosId WAJIB.
///   - roomId OPSIONAL — kalau null, maintenance fasilitas kos (pompa,
///     taman, listrik). Kalau ada, terikat ke kamar tertentu.
model Maintenance {
  id              String   @id @default(cuid())
  type            String   // "PREVENTIVE" | "CORRECTIVE"
  kosId           String
  roomId          String?

  title           String
  description     String?

  status          String   @default("SCHEDULED") // "SCHEDULED" | "IN_PROGRESS" | "COMPLETED" | "CANCELLED"
  scheduledDate   DateTime
  completedDate   DateTime?

  cost            Int?     // biaya perbaikan, dalam rupiah
  vendor          String?  // tukang / penyedia jasa
  notes           String?  // catatan tambahan setelah selesai
  photoUrls       String?  // JSON array of /uploads/... (foto before/after)

  // Recurrence (preventive saja)
  recurrenceMonths    Int?    // null = one-shot, 1/3/6/12 = setiap N bulan
  parentMaintenanceId String? // link ke record sebelumnya (auto-generated chain)

  // Korektif linkage
  complaintId     String?  @unique // 1:1 dengan Complaint

  // Apakah penghuni kamar yang terdampak perlu diberitahu (perawatan
  // mengganggu akses kamar mereka). Default false — kebanyakan perawatan
  // tidak perlu disampaikan ke penghuni. Hanya berlaku kalau roomId set
  // dan kamar terisi (status OCCUPIED).
  notifyTenant    Boolean  @default(false)

  // Reminder log per-jenis (anti-duplikat WA/email)
  reminderH7Sent  Boolean  @default(false)
  reminderH3Sent  Boolean  @default(false)
  reminderH1Sent  Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  kos             Kos          @relation(fields: [kosId], references: [id], onDelete: Cascade)
  room            Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  complaint       Complaint?   @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  parent          Maintenance? @relation("MaintenanceRecurrence", fields: [parentMaintenanceId], references: [id], onDelete: SetNull)
  children        Maintenance[] @relation("MaintenanceRecurrence")

  @@index([kosId, status])
  @@index([roomId])
  @@index([scheduledDate])
  @@index([type, status])
}

model RoomMoveRequest {
  id         String    @id @default(cuid())
  tenancyId  String
  fromRoomId String
  toRoomId   String
  reason     String?
  status     String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  ownerNote  String?
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?

  tenancy    Tenancy   @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  fromRoom   Room      @relation("FromMove", fields: [fromRoomId], references: [id], onDelete: Cascade)
  toRoom     Room      @relation("ToMove", fields: [toRoomId], references: [id], onDelete: Cascade)

  @@index([tenancyId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// Key-value store untuk toggle/konfigurasi runtime yang admin bisa ubah
// lewat /admin/system tanpa redeploy. Bedanya dengan env var: nilainya
// bisa diubah hidup-hidup. Konsumen pakai helper getSetting() di
// src/lib/settings.ts yang punya cache memory.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Langganan Web Push (PWA) per device. 1 user bisa punya banyak device.
// Dipakai src/lib/push.ts untuk kirim notifikasi push ke HP penghuni
// tanpa buka app — mengurangi ketergantungan kuota WA.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Pengeluaran operasional per kos. Penanggung pasangan dari Payment
/// (pemasukan). Bersama-sama jadi sumber data laporan Profit & Loss.
/// Kategori sengaja string supaya bisa di-extend tanpa migrasi; helper
/// di src/lib/expenses.ts memvalidasi & memberi label.
model Expense {
  id          String   @id @default(cuid())
  kosId       String
  createdById String
  category    String   // "UTILITY" | "STAFF" | "MAINTENANCE" | "SUPPLIES" | "TAX" | "OTHER"
  date        DateTime // tanggal pengeluaran (untuk grouping bulanan)
  amount      Int      // rupiah, positive integer
  note        String?
  attachmentUrl String? // optional /uploads/... untuk struk/nota
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  kos       Kos  @relation(fields: [kosId], references: [id], onDelete: Cascade)
  createdBy User @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([kosId, date])
  @@index([createdById])
  @@index([category])
}

/// Audit log untuk aksi sensitif. Tujuannya satu: kalau ada sengketa
/// ("siapa yang verifikasi pembayaran ini?", "kapan akun ini disuspend?")
/// kita punya jejak. Hanya admin/owner yang lihat.
///
/// Konvensi:
///   - action: format "ENTITY.VERB" (mis. "PAYMENT.VERIFY", "USER.SUSPEND")
///   - entityType + entityId: target aksi (boleh null untuk system action)
///   - metadata: JSON string bebas dengan konteks (sebelum/sesudah, alasan)
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  // null = system / cron
  actorName  String?  // snapshot nama saat aksi (tahan terhadap user dihapus)
  action     String   // "PAYMENT.VERIFY", "USER.SUSPEND", dst
  entityType String?  // "Payment" | "User" | "Tenancy" | "Expense" | dst
  entityId   String?
  metadata   String?  // JSON
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// Pengumuman broadcast dari pemilik ke seluruh penghuni 1 kos (atau
// semua kos miliknya kalau kosId null). Saat dibuat, di-fan-out jadi
// Notification + email + Web Push ke tiap penghuni aktif. Record ini
// menyimpan riwayat broadcast (siapa, kapan, ke berapa orang).
model Announcement {
  id            String   @id @default(cuid())
  authorId      String
  kosId         String?  // null = semua kos milik author
  title         String
  body          String
  audienceCount Int      @default(0)
  createdAt     DateTime @default(now())

  author        User     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  kos           Kos?     @relation(fields: [kosId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([kosId])
}
